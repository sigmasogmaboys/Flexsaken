    local function TryKey()
        local Typed = string.gsub(Input.Text, "^%s*(.-)%s*$", "%1")
        if Typed == ValidKey then
            Passed = true
            KeyGui:Destroy()
        else
            Status.Text = "Invalid key"
        end
    end
    Verify.Activated:Connect(TryKey)
    Input.FocusLost:Connect(function(EnterPressed)
        if EnterPressed then TryKey() end
    end)

    repeat task.wait(0.1) until Passed or not KeyGui.Parent
    if not Passed then return end
